# Server Port (Render sets PORT automatically, but default is 3001)
PORT=3001

# Production / Development Mode
NODE_ENV=development

# JWT Secret for Auth Token signing (generate a strong random secret in production)
JWT_SECRET=dev-secret-change-in-production

# Frontend Client URL(s) allowed by CORS (e.g., https://your-app.vercel.app)
# You can provide multiple comma-separated URLs
CLIENT_URL=http://localhost:5173

# Uploads directory and limits
UPLOAD_DIR=../uploads
MAX_FILE_SIZE_MB=10
